                        .thumbnail-mary-figure
                          img(src='images/galleryDroite/gallery-small-image-5-330x240.png', alt='', width='330', height='240')
                        .thumbnail-mary-caption
                          a.icon.fl-bigmug-line-zoom60(href='images/galleryDroite/gallery-original-image-5-1200x800.jpg', data-lightgallery='item')
                            img(src='images/galleryDroite/gallery-small-image-5-330x240.png', alt='', width='330', height='240')